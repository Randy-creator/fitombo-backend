# =====================================================================
# Modèle de variables d'environnement - À COMMITER (aucune vraie valeur secrète)
# Copie ce fichier en ".env" (qui est ignoré par Git) puis remplis les vraies valeurs :
#     cp .env.example .env
#
# Format : CLE=valeur, SANS guillemets et SANS espaces autour du "="
# =====================================================================

# --- Base de données (utilisées par compose.yaml ET par l'application) ---
DB_NAME=fitombo
DB_USERNAME=fitombo
# Génère un mot de passe fort : openssl rand -base64 24
DB_PASSWORD=CHANGE_MOI
DB_PORT=5433
DB_URL=jdbc:postgresql://127.0.0.1:5433/fitombo

# --- JWT ---
# Au moins 32 caractères aléatoires. Génère-le avec : openssl rand -base64 48
JWT_SECRET=CHANGE_MOI_AVEC_UNE_LONGUE_VALEUR_ALEATOIRE

# --- CORS (origines autorisées, séparées par des virgules) ---
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8081

# E-mail : disabled, console (dev), brevo
EMAIL_MODE=disabled
EMAIL_FROM=
BREVO_API_KEY=
